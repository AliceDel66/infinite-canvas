POSTGRES_DB=infinite_canvas
POSTGRES_USER=infinite_canvas
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DATA_PATH=postgres-data
POSTGRES_IMAGE=postgres:17-alpine

MINIO_ROOT_USER=replace-with-a-random-access-key
MINIO_ROOT_PASSWORD=replace-with-a-long-random-secret
MINIO_DATA_PATH=minio-data
MINIO_IMAGE=minio/minio:latest
MINIO_MC_IMAGE=minio/mc:latest
S3_BUCKET=infinite-canvas
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=replace-with-a-separate-app-access-key
S3_SECRET_ACCESS_KEY=replace-with-a-separate-app-secret

BACKUP_ROOT=/data/backups/infinite-canvas
BACKUP_RETENTION_DAYS=14
API_IMAGE_REPOSITORY=infinite-canvas-api
WEB_IMAGE_REPOSITORY=infinite-canvas-web
IMAGE_TAG=local
PRODUCTION_HEALTH_URL=

APP_BIND_HOST=127.0.0.1
APP_PORT=3000
APP_ORIGINS=http://localhost:3000,http://localhost:3001
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

IMPORT_MAX_DOMAIN_BYTES=16777216
IMPORT_MAX_FILE_BYTES=268435456
IMPORT_MAX_TOTAL_BYTES=21474836480

# Production deployment on the current server:
# APP_ORIGINS=https://canvas.zgonline.top
# BETTER_AUTH_URL=https://canvas.zgonline.top
# POSTGRES_DATA_PATH=/data/infinite-canvas/postgres
# MINIO_DATA_PATH=/data/infinite-canvas/minio
# API_IMAGE_REPOSITORY=ghcr.io/your-github-owner/infinite-canvas-api
# WEB_IMAGE_REPOSITORY=ghcr.io/your-github-owner/infinite-canvas-web
# PRODUCTION_HEALTH_URL=https://canvas.example.com/api/v1/health

# Enable only after sub2api has been extended with an OAuth2/OIDC Provider.
# SUB2API_OIDC_DISCOVERY_URL=https://api.zgonline.top/.well-known/openid-configuration
SUB2API_OIDC_DISCOVERY_URL=
SUB2API_CLIENT_ID=
SUB2API_CLIENT_SECRET=
