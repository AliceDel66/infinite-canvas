        "@fastify/helmet": "^13.1.0",
        "@fastify/multipart": "^10.1.0",
        "@fastify/rate-limit": "^11.2.0",
        "better-auth": "^1.6.26",
        "dotenv": "^17.2.3",
        "drizzle-orm": "^0.45.2",
        "fastify": "^5.11.3",
        "postgres": "^3.4.9",
        "zod": "^4.4.3"
    },
    "devDependencies": {
