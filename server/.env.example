NODE_ENV=development
PORT=3002
DATABASE_URL=postgres://infinite_canvas:change-me@localhost:5432/infinite_canvas
APP_ORIGINS=http://localhost:3000,http://localhost:3001
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=infinite-canvas
S3_ACCESS_KEY_ID=replace-with-a-random-access-key
S3_SECRET_ACCESS_KEY=replace-with-a-long-random-secret
S3_FORCE_PATH_STYLE=true
IMPORT_MAX_DOMAIN_BYTES=16777216
IMPORT_MAX_FILE_BYTES=268435456
IMPORT_MAX_TOTAL_BYTES=21474836480

# Enable only after the deployed sub2api instance exposes a real OIDC discovery document.
SUB2API_OIDC_DISCOVERY_URL=
SUB2API_CLIENT_ID=
SUB2API_CLIENT_SECRET=
